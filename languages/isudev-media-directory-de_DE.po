#. Plugin Name of the plugin
#: isudev-media-directory.php
msgid "IsuDev Media Directory"
msgstr "IsuDev Media Directory"

#. Plugin URI of the plugin
#: isudev-media-directory.php
msgid "https://github.com/IsuDevelopment/wp-media-directory"
msgstr "https://github.com/IsuDevelopment/wp-media-directory"

#. Description of the plugin
#: isudev-media-directory.php
msgid "Simple folders for the Media Library. Files stay visible across the whole folder tree, moves can be undone, and the folders work in every media modal."
msgstr "Einfache Ordner für die Mediathek. Dateien bleiben im ganzen Ordnerbaum sichtbar, Verschiebungen lassen sich rückgängig machen und die Ordner funktionieren in jedem Medien-Dialog."

#. Author of the plugin
#: isudev-media-directory.php
msgid "IsuDev"
msgstr "IsuDev"

#. Author URI of the plugin
#: isudev-media-directory.php
msgid "https://isudev.pl"
msgstr "https://isudev.pl"

