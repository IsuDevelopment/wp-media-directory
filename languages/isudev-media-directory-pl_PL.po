#. translators: 1: plugin name, 2: folders created, 3: folders reused, 4: files filed.
#: includes/settings.php:606
msgid "Imported from %1$s. Folders created: %2$d · Existing folders reused: %3$d · Files filed: %4$d."
msgstr "Zaimportowano z %1$s. Utworzone foldery: %2$d · Wykorzystane istniejące: %3$d · Przypisane pliki: %4$d."

#: includes/settings.php:47
msgid "Show files from subfolders in parent folders"
msgstr "Pokazuj pliki z podfolderów w folderach nadrzędnych"

#: includes/settings.php:48
msgid "Also switchable with the toggle above the folder tree."
msgstr "Można to też przełączać przełącznikiem nad drzewem folderów."

#: includes/settings.php:52
#: build/index.js:17
msgid "Show subfolders above the files"
msgstr "Pokazuj podfoldery nad plikami"

#: includes/settings.php:53
msgid "Breadcrumb tiles for the folders inside the open folder, with a “New folder” tile."
msgstr "Kafelki folderów znajdujących się w otwartym folderze, z kafelkiem „Nowy folder”."

#: includes/settings.php:57
#: build/index.js:17
msgid "Open the current folder in the tree"
msgstr "Otwieraj bieżący folder w drzewie"

#: includes/settings.php:58
msgid "Expands the tree to the folder you open from a tile or the breadcrumb."
msgstr "Rozwija drzewo do folderu otwartego z kafelka lub ścieżki."

#: includes/settings.php:62
#: build/index.js:17
msgid "Remember the last folder separately for each content type"
msgstr "Zapamiętuj ostatni folder osobno dla każdego typu treści"

#: includes/settings.php:63
msgid "For example one folder when adding images to products and another for posts."
msgstr "Na przykład jeden folder przy dodawaniu zdjęć do produktów, a inny do wpisów."

#: includes/settings.php:316
msgid "Defaults for everyone"
msgstr "Domyślne dla wszystkich"

#: includes/settings.php:317
msgid "How the folders behave for users who have not changed it themselves. Everyone can adjust these for their own account from the ⚙ menu above the folder tree."
msgstr "Jak zachowują się foldery dla użytkowników, którzy nie zmienili tego sami. Każdy może to dostosować dla swojego konta w menu ⚙ nad drzewem folderów."

#: includes/settings.php:325
msgid "On"
msgstr "Włączone"

#: build/index.js:17
msgid "View options"
msgstr "Opcje widoku"
