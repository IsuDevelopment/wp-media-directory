#. Plugin Name of the plugin
#: isudev-media-directory.php
msgid "IsuDev Media Directory"
msgstr "IsuDev Media Directory"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: isudev-media-directory.php
msgid "https://isudev.pl"
msgstr "https://isudev.pl"

#. Description of the plugin
#: isudev-media-directory.php
msgid "Simple folders for the Media Library. Files stay visible across the whole folder tree, moves can be undone, and the folders work in every media modal."
msgstr "Proste foldery w bibliotece mediów. Pliki są widoczne w całym drzewie folderów, przeniesienia można cofnąć, a foldery działają w każdym oknie wyboru mediów."

#. Author of the plugin
#: isudev-media-directory.php
msgid "IsuDev"
msgstr "IsuDev"

#: includes/rest.php:230
#: includes/rest.php:272
msgid "Folder name cannot be empty."
msgstr "Nazwa folderu nie może być pusta."

#: includes/rest.php:234
msgid "The parent folder no longer exists."
msgstr "Folder nadrzędny już nie istnieje."

#: includes/rest.php:258
#: includes/rest.php:306
#: includes/rest.php:412
msgid "Folder not found."
msgstr "Nie znaleziono folderu."

#: includes/rest.php:280
#: build/index.js:11
msgid "A folder cannot be moved into itself."
msgstr "Nie można przenieść folderu do niego samego."

#: includes/rest.php:318
msgid "Choose a folder outside the one being deleted."
msgstr "Wybierz folder spoza usuwanego folderu."

#: includes/rest.php:324
msgid "You are not allowed to delete some of these files."
msgstr "Nie masz uprawnień do usunięcia części tych plików."

#: includes/rest.php:408
msgid "No files you can edit were selected."
msgstr "Nie zaznaczono plików, które możesz edytować."

#: includes/settings.php:66
#: includes/settings.php:67
#: includes/settings.php:107
#: build/index.js:18
msgid "Folder settings"
msgstr "Ustawienia folderów"

#. translators: 1: number of folders, 2: number of files.
#: includes/settings.php:115
msgid "Imported %1$d folders and filed %2$d files."
msgstr "Zaimportowano foldery: %1$d, przypisano pliki: %2$d."

#: includes/settings.php:128
#: build/index.js:21
msgid "Subfolders"
msgstr "Podfoldery"

#: includes/settings.php:132
msgid "Show files from subfolders in parent folders by default"
msgstr "Domyślnie pokazuj pliki z podfolderów w folderach nadrzędnych"

#: includes/settings.php:134
msgid "Everyone can still switch this with the toggle above the folder tree. Their choice is remembered."
msgstr "Każdy użytkownik może to zmienić przełącznikiem nad drzewem folderów. Jego wybór jest zapamiętywany."

#: includes/settings.php:141
msgid "Import from HappyFiles"
msgstr "Import z HappyFiles"

#: includes/settings.php:143
msgid "No HappyFiles folders found on this site."
msgstr "Na tej stronie nie znaleziono folderów HappyFiles."

#. translators: 1: number of folders, 2: number of folders already imported.
#: includes/settings.php:149
msgid "Found %1$d HappyFiles folders, %2$d of them already imported."
msgstr "Znaleziono foldery HappyFiles: %1$d, w tym już zaimportowane: %2$d."

#: includes/settings.php:155
msgid "Copies the folder tree and which file sits where. HappyFiles data is left untouched, and running it again only adds what is missing."
msgstr "Kopiuje drzewo folderów i przypisania plików. Dane HappyFiles pozostają nietknięte, a ponowne uruchomienie dodaje tylko to, czego brakuje."

#: includes/settings.php:159
msgid "Import folders"
msgstr "Importuj foldery"

#: includes/settings.php:173
msgid "Sorry, you are not allowed to do that."
msgstr "Niestety, nie masz uprawnień, aby to zrobić."

