#: includes/settings.php:347
msgid "Choose what each role can do with folders. Only roles that can upload files are listed."
msgstr "Wybierz, co każda rola może robić z folderami. Lista zawiera tylko role, które mogą wgrywać pliki."

#: includes/settings.php:354
msgid "Role"
msgstr "Rola"

#: includes/settings.php:390
msgid "Administrators can always do everything. Organizing, creating or deleting includes seeing folders. Empty folders can be deleted by anyone who can create them, so a new folder can be undone. Permanently deleting files still follows WordPress’ own rules."
msgstr "Administratorzy zawsze mogą wszystko. Porządkowanie, tworzenie i usuwanie obejmuje widzenie folderów. Puste foldery może usunąć każdy, kto może je tworzyć, dzięki czemu da się cofnąć utworzenie folderu. Trwałe usuwanie plików nadal podlega regułom WordPressa."

#: includes/settings.php:416
msgid "Copy folders and which file sits where from another media folder plugin. Its own data is not changed, and an import can be repeated: it only adds what is missing."
msgstr "Skopiuj foldery i przypisania plików z innej wtyczki do folderów mediów. Jej dane nie są zmieniane, a import można powtórzyć: doda tylko to, czego brakuje."

#: includes/settings.php:423
msgid "Nothing to import from"
msgstr "Brak danych do importu"

#: includes/settings.php:455
msgid "The plugin is still active."
msgstr "Wtyczka jest nadal aktywna."

#: includes/settings.php:464
msgid "Where to put the folders"
msgstr "Gdzie umieścić foldery"

#: includes/settings.php:468
msgid "Merge with my folders"
msgstr "Scal z moimi folderami"

#. translators: %d: number of folders.
#: includes/settings.php:476
msgid "%d top-level folder has the same name as one of yours and will be combined with it."
msgid_plural "%d top-level folders have the same name as yours and will be combined with them."
msgstr[0] "%d folder najwyższego poziomu ma taką samą nazwę jak jeden z Twoich i zostanie z nim połączony."
msgstr[1] "%d foldery najwyższego poziomu mają takie same nazwy jak Twoje i zostaną z nimi połączone."
msgstr[2] "%d folderów najwyższego poziomu ma takie same nazwy jak Twoje i zostanie z nimi połączonych."

#: includes/settings.php:481
msgid "Folders with the same name in the same place are combined."
msgstr "Foldery o tej samej nazwie w tym samym miejscu zostaną połączone."

#. translators: %s: plugin name.
#: includes/settings.php:493
msgid "Put everything in a new folder “%s”"
msgstr "Umieść wszystko w nowym folderze „%s”"

#: includes/settings.php:505
msgid "Also copy HappyFiles folder access per role to Permissions"
msgstr "Skopiuj też dostęp do folderów HappyFiles dla ról do Uprawnień"

#. translators: %s: plugin name.
#: includes/settings.php:523
msgid "After importing you can delete %s’s folder data from the database. Files stay in the library; only that plugin’s folders and assignments are removed. This cannot be undone."
msgstr "Po imporcie możesz usunąć z bazy dane folderów wtyczki %s. Pliki zostają w bibliotece; znikają tylko foldery i przypisania tej wtyczki. Tej operacji nie można cofnąć."

#. translators: %s: plugin name.
#: includes/settings.php:535
msgid "Deactivate %s first."
msgstr "Najpierw dezaktywuj %s."

#: includes/settings.php:545
msgid "I understand this cannot be undone"
msgstr "Rozumiem, że tego nie można cofnąć"

#. translators: %s: plugin name.
#: includes/settings.php:552
msgid "Delete %s folder data"
msgstr "Usuń dane folderów %s"

#: includes/settings.php:584
msgid "Unknown import source."
msgstr "Nieznane źródło importu."

#. translators: %d: number of roles.
#: includes/settings.php:617
msgid "Folder access copied for %d role."
msgid_plural "Folder access copied for %d roles."
msgstr[0] "Skopiowano dostęp do folderów dla %d roli."
msgstr[1] "Skopiowano dostęp do folderów dla %d ról."
msgstr[2] "Skopiowano dostęp do folderów dla %d ról."

#. translators: %d: number of users.
#: includes/settings.php:624
msgid "%d user had personal HappyFiles access; personal settings are not supported, so they now follow their role."
msgid_plural "%d users had personal HappyFiles access; personal settings are not supported, so they now follow their role."
msgstr[0] "%d użytkownik miał własny dostęp w HappyFiles; ustawienia indywidualne nie są obsługiwane, więc teraz obowiązuje go jego rola."
msgstr[1] "%d użytkowników miało własny dostęp w HappyFiles; ustawienia indywidualne nie są obsługiwane, więc teraz obowiązują ich ich role."
msgstr[2] "%d użytkowników miało własny dostęp w HappyFiles; ustawienia indywidualne nie są obsługiwane, więc teraz obowiązują ich ich role."

#: includes/settings.php:645
msgid "Nothing was deleted: please tick the confirmation box."
msgstr "Nic nie usunięto: zaznacz pole potwierdzenia."

#. translators: %s: plugin name.
#: includes/settings.php:656
msgid "%s folder data deleted."
msgstr "Usunięto dane folderów %s."

#. translators: 1: number of folders, 2: number of files, 3: number of folders already imported.
#: includes/settings.php:447
