{
	"name": "@isudev/media-directory",
	"version": "0.4.1",
	"description": "Simple, fast folders for the WordPress Media Library.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"engines": {
		"node": ">=22.22.2 <23",
		"npm": ">=10"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/primitives": "^4.57.0",
		"@wordpress/scripts": "^31.8.0",
		"clsx": "^2.1.1",
		"typescript": "^5.9.3"
	},
	"prettier": "@wordpress/prettier-config",
	"scripts": {
		"build": "wp-scripts build src/index.js",
		"start": "wp-scripts start src/index.js",
		"format": "wp-scripts format src",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"i18n:make-pot": "wp i18n make-pot . languages/isudev-media-directory.pot --exclude=node_modules,vendor,example,src --skip-audit",
		"i18n:update-po": "wp i18n update-po languages/isudev-media-directory.pot languages",
		"i18n:make-mo": "wp i18n make-mo languages",
		"i18n:make-php": "wp i18n make-php languages",
		"i18n:make-json": "rm -f languages/*.json && wp i18n make-json languages --no-purge",
		"i18n:build": "npm run i18n:make-mo && npm run i18n:make-php && npm run i18n:make-json",
		"lint:php": "vendor/bin/phpcs",
		"test:smoke": "wp eval-file tools/smoke.php",
		"test:i18n": "php tools/check-translations.php",
		"check": "npm run lint:js && npm run lint:css && npm run lint:php && npm run test:js && npm run test:version && npm run test:docs && npm run test:i18n && npm run test:smoke",
		"test:version": "php tools/check-version.php",
		"test:docs": "php tools/check-docs.php",
		"test:js": "wp-scripts test-unit-js src"
	}
}
